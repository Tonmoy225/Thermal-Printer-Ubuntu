# Eta copy kore .env.local naam e rakho
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER.mongodb.net/printhub
BETTER_AUTH_SECRET=ekta-lomba-random-string-dao
BETTER_AUTH_URL=http://localhost:3000
# Ai email diye signup korle admin hobe
ADMIN_EMAIL=you@example.com

# Forgot password email (Gmail): Google Account > Security > App passwords
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-letter-app-password
